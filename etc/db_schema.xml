<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="quote_immutable" resource="checkout" engine="innodb" comment="Immutable Quote Lock State">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true"
                comment="Entity ID"/>
        <column xsi:type="int" name="quote_id" unsigned="true" nullable="false"
                comment="Quote ID"/>
        <column xsi:type="boolean" name="is_immutable" nullable="false" default="false"
                comment="Whether the quote is commercially locked"/>
        <column xsi:type="datetime" name="locked_at" nullable="true"
                comment="Lock timestamp"/>
        <column xsi:type="varchar" name="locked_reason" nullable="true" length="255"
                comment="Lock reason"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="QUOTE_IMMUTABLE_QUOTE_ID_QUOTE_ENTITY_ID"
                    table="quote_immutable" column="quote_id" referenceTable="quote"
                    referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="unique" referenceId="QUOTE_IMMUTABLE_QUOTE_ID">
            <column name="quote_id"/>
        </constraint>
        <index referenceId="QUOTE_IMMUTABLE_IS_IMMUTABLE" indexType="btree">
            <column name="is_immutable"/>
        </index>
    </table>
</schema>
